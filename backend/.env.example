# Postgres started by docker-compose.yml at the repo root.
DATABASE_URL=postgresql+asyncpg://agentmarket:agentmarket@localhost:5432/agentmarket

# Azure OpenAI — required for chat to work.
# Find these in the Azure Portal under your Azure OpenAI resource -> Keys and Endpoint,
# and under Deployments for the deployment name (not the underlying model name).
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE-NAME.openai.azure.com
AZURE_OPENAI_API_KEY=your-azure-openai-key
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=gpt-4o
# Needed only for the knowledge-base feature (semantic search over uploaded files).
# Create an embeddings deployment (e.g. text-embedding-3-small) in the same Azure OpenAI resource.
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
AUTO_SEED=true
